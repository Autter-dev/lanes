// The install count's Worker. README.md says how to host it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanes-install-count",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // `lane` sends to https://lanes-count.autter.dev/v1/installs (lane_core::telemetry::ENDPOINT).
  // autter.dev is on Cloudflare, so deploying creates this address and its certificate.
  "routes": [{ "pattern": "lanes-count.autter.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // The counts. `npm run deploy` applies migrations/ to it before deploying the Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanes-install-count",
      "database_id": "2f15ee3e-d722-4fdc-a194-2dbe2f30ccf8",
      "migrations_dir": "migrations"
    }
  ],

  // Request logs would hold callers' IP addresses, which this service promises not to keep.
  "observability": { "enabled": false },

  // At most 20 requests a minute from one address. Counted by Cloudflare, never stored here.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
